{
  "name": "flowshield",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "node src/simulation/verify.mjs",
    "train": "node scripts/train-surrogate.mjs 4000",
    "data": "python3 data/bengaluru/fetch.py && python3 data/bengaluru/fetch_event_2022.py && python3 data/bengaluru/build_exposure.py"
  },
  "dependencies": {
    "maplibre-gl": "^6.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
